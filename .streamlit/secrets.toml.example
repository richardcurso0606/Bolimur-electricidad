# =========================================================================
# BOLIMUR REBT PRO - Configuración de Credenciales y Google OAuth 2.0
# =========================================================================
# Para habilitar el inicio de sesión oficial con Google Cloud:
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea un 'ID de cliente de OAuth 2.0' (Tipo: Aplicación web)
# 3. Añade 'http://localhost:8501' en URIs de redirección autorizados
# 4. Copia este archivo como '.streamlit/secrets.toml' y pega tus claves abajo:

[google_oauth]
client_id = "TU_CLIENT_ID_DE_GOOGLE.apps.googleusercontent.com"
client_secret = "TU_CLIENT_SECRET_DE_GOOGLE"
redirect_uri = "http://localhost:8501"
